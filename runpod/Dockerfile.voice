# GNSIS voice runtime for a RunPod GPU pod.
#
# The same software as the Modal app in modal/gnsis_voice.py: Python 3.11, the
# pinned dependencies in runpod/requirements-voice.txt, the realtime source
# under runtime/, and the faster-whisper ASR model baked in. Model weights are
# not in the image; they live on a RunPod network volume mounted at /models.
#
# Build from the repository root:
#   docker build -f runpod/Dockerfile.voice -t gnsis-voice .
FROM python:3.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential ca-certificates ffmpeg git libgl1 libglib2.0-0 libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

# Dependencies first, so a source-only change reuses this (large) layer.
COPY runpod/requirements-voice.txt /tmp/requirements-voice.txt
RUN python -m pip install --upgrade pip \
    && python -m pip install -r /tmp/requirements-voice.txt

# The config refers to /workspace/runtime/configs/..., so the source lives
# there. Do not mount the network volume at /workspace: it would hide this.
COPY runtime /workspace/runtime
RUN python -m pip install --no-deps /workspace/runtime/minicpm_ft /workspace/runtime/gnsis_runtime \
    && mkdir -p /var/gnsis/ledger /opt/gnsis-asr \
    && python -c "from huggingface_hub import snapshot_download; snapshot_download('Systran/faster-whisper-small.en', local_dir='/opt/gnsis-asr/faster-whisper-small.en')"

COPY runpod/start-voice.sh /usr/local/bin/start-voice
COPY runpod/idle_stop.py /usr/local/bin/idle_stop.py
RUN chmod 0755 /usr/local/bin/start-voice

WORKDIR /workspace
EXPOSE 7975
CMD ["start-voice"]
