{
  "name": "@gnsis/ui",
  "version": "0.1.0",
  "private": true,
  "description": "GNSIS product UI: dock, bar, chats, agent panels, live voice. React, host-agnostic; the Electron renderer and GNSISFRONTEND both mount it.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./hosts/simulated": "./src/hosts/simulated.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p ."
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@blobatar/react": "2.7.0",
    "blobatar": "2.7.0"
  }
}
