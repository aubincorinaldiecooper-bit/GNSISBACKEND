{
  "name": "gnsis-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "GNSIS desktop — realtime perception, playback ACKs, and the tools seam",
  "main": "dist/main/main.js",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p ui",
    "test": "tsx --test src/**/*.test.ts ui/src/**/*.test.ts",
    "package": "npm run build && electron-builder",
    "package:mac": "npm run build && electron-builder --mac --arm64",
    "package:mac:dir": "npm run build && electron-builder --mac --arm64 --dir",
    "ui:preview": "node scripts/ui-preview.mjs"
  },
  "dependencies": {
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.8",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "electron": "^39.2.7",
    "electron-builder": "26.15.3",
    "esbuild": "^0.25.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.20.3",
    "typescript": "^5.0.0"
  },
  "productName": "GNSIS",
  "author": {
    "name": "GNSIS"
  },
  "workspaces": [
    "ui"
  ]
}
