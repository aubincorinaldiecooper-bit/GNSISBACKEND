{
  "version": "desktop-v4",
  "tools": [
    {
      "name": "open",
      "description": "Open an app, a web address, or a file or folder on the person's Mac. Web addresses open in their own browser.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target"
        ],
        "properties": {
          "target": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "description": "An app name like Spotify, a web address, or a file or folder like Downloads."
          }
        }
      }
    },
    {
      "name": "files",
      "description": "See or change files and folders on the person's Mac. A bare name is looked for in the open Finder window and the usual folders. selected means what is selected in Finder.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action"
        ],
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "list",
              "find",
              "move",
              "rename",
              "new_folder"
            ]
          },
          "path": {
            "type": "string",
            "maxLength": 512,
            "description": "The file or folder acted on. For list and find, the folder to look in."
          },
          "to": {
            "type": "string",
            "maxLength": 512,
            "description": "For move, the folder to move it into."
          },
          "name": {
            "type": "string",
            "maxLength": 255,
            "description": "For rename, the new name. For new_folder, its name."
          },
          "query": {
            "type": "string",
            "maxLength": 128,
            "description": "For find, part of the name or a kind such as pdf."
          }
        }
      }
    },
    {
      "name": "browser",
      "description": "Use the person's open browser without an extension. Chrome/Edge prefer Cua browser bindings; other browsers use Cua native control.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action"
        ],
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "tabs",
              "switch",
              "new_tab",
              "go",
              "back",
              "forward",
              "reload",
              "prepare",
              "inspect",
              "upload",
              "download",
              "dialog"
            ]
          },
          "url": {
            "type": "string",
            "maxLength": 2048,
            "description": "For go, the address to load in the current tab; for new_tab, an optional address."
          },
          "tab": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "For switch, the tab number from tabs."
          },
          "ref": {
            "type": "string",
            "maxLength": 256,
            "description": "Live Cua browser element ref for upload/download."
          },
          "files": {
            "type": "array",
            "description": "Absolute local file paths for upload."
          },
          "destination_root": {
            "type": "string",
            "maxLength": 1024,
            "description": "Existing absolute directory for a download."
          },
          "dialog_action": {
            "type": "string",
            "enum": [
              "inspect",
              "accept",
              "dismiss"
            ],
            "description": "For browser dialog handling."
          },
          "dialog_id": {
            "type": "string",
            "maxLength": 256,
            "description": "Opaque current dialog id returned by inspect."
          },
          "prompt_text": {
            "type": "string",
            "maxLength": 2000,
            "description": "Optional prompt response text when accepting a browser prompt."
          }
        }
      }
    },
    {
      "name": "input",
      "description": "Type, press keys, click, right-click, scroll, or drag on the desktop through Cua. Optional app/window fields target a specific window. Panoptic verifies visual effects.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action"
        ],
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "type",
              "keys",
              "click",
              "right_click",
              "scroll",
              "drag"
            ]
          },
          "text": {
            "type": "string",
            "maxLength": 1000,
            "description": "For type, the text."
          },
          "keys": {
            "type": "string",
            "maxLength": 64,
            "description": "For keys, like cmd+f, enter, escape."
          },
          "label": {
            "type": "string",
            "maxLength": 128,
            "description": "For click, the visible name of the button or item."
          },
          "x": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "For click without a name, 0 to 1 across the shared screen."
          },
          "y": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "0 to 1 down the shared screen."
          },
          "app": {
            "type": "string",
            "maxLength": 128,
            "description": "Optional app name to target instead of the frontmost app."
          },
          "window": {
            "type": "string",
            "maxLength": 256,
            "description": "Optional window title to target."
          },
          "direction": {
            "type": "string",
            "enum": [
              "up",
              "down",
              "left",
              "right"
            ],
            "description": "For scroll."
          },
          "amount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "description": "For scroll, number of lines."
          },
          "from_x": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "For drag, start x across the shared screen."
          },
          "from_y": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "For drag, start y down the shared screen."
          },
          "to_x": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "For drag, end x across the shared screen."
          },
          "to_y": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "For drag, end y down the shared screen."
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000,
            "description": "Optional drag duration."
          }
        }
      }
    },
    {
      "name": "window",
      "description": "List, focus, move, or resize application windows through Cua Driver.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action"
        ],
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "list",
              "focus",
              "move_resize"
            ]
          },
          "app": {
            "type": "string",
            "maxLength": 128,
            "description": "App name to target."
          },
          "title": {
            "type": "string",
            "maxLength": 256,
            "description": "Window title to target."
          },
          "on_screen_only": {
            "type": "boolean",
            "description": "For list, return only visible/on-screen windows."
          },
          "x": {
            "type": "number",
            "description": "For move_resize, new left edge."
          },
          "y": {
            "type": "number",
            "description": "For move_resize, new top edge."
          },
          "width": {
            "type": "number",
            "minimum": 1,
            "description": "For move_resize, new width."
          },
          "height": {
            "type": "number",
            "minimum": 1,
            "description": "For move_resize, new height."
          }
        }
      }
    },
    {
      "name": "clipboard",
      "description": "Read clipboard types/text or replace the clipboard with text, an image path, or a file URL through Cua Driver.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action"
        ],
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "read",
              "write"
            ]
          },
          "include_text": {
            "type": "boolean",
            "description": "For read, include privacy-sensitive plain text."
          },
          "text": {
            "type": "string",
            "maxLength": 20000,
            "description": "For write, plain text."
          },
          "file_path": {
            "type": "string",
            "maxLength": 1024,
            "description": "For write, absolute local file path."
          },
          "image_path": {
            "type": "string",
            "maxLength": 1024,
            "description": "For write, absolute local image path."
          }
        }
      }
    }
  ]
}
